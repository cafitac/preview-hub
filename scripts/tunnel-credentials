#!/bin/sh
set -eu
# Disable tracing even if invoked with sh -x. The credentials are only ever stdin data.
set +x
quote() { printf "'"; printf '%s' "$1" | sed "s/'/'\\\\''/g"; printf "'"; }
uid_gid=${PHUB_UID_GID:-0:0}
host=${PHUB_SSH_HOST:-trading-macstudio}
remote_path=${PHUB_REMOTE_PATH:-/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin}
case ${1:-} in
    --check) [ "$#" -eq 1 ] || exit 2; mode=check ;;
    '') [ "$#" -eq 0 ] || exit 2; mode=install ;;
    *) echo 'Usage: tunnel-credentials [--check] (credentials on stdin)' >&2; exit 2 ;;
esac
vm_script=$(cat <<'VM'
set -eu
set +x
file=/opt/phub/secrets/tunnel.json
if [ "$1" = check ]; then
    if [ -f "$file" ] && [ -s "$file" ]; then
        echo 'credentials present'
        exit 0
    fi
    echo 'credentials missing'
    exit 1
fi
umask 077
mkdir -p /opt/phub/secrets
chown "$2" /opt/phub/secrets
chmod 0700 /opt/phub/secrets
tmp=$(mktemp /opt/phub/secrets/.tunnel.json.XXXXXX)
trap 'rm -f "$tmp"' 0 HUP INT TERM
cat > "$tmp"
[ -s "$tmp" ] || { echo 'credentials missing' >&2; exit 2; }
chown "$2" "$tmp"
chmod 0400 "$tmp"
mv -f "$tmp" "$file"
VM
)
command="export PATH=$(quote "$remote_path"); colima ssh --profile preview-hub -- sudo -n sh -c $(quote "$vm_script") sh $(quote "$mode") $(quote "$uid_gid")"
if [ "$mode" = check ]; then
    exec ssh ${PHUB_SSH_OPTS:-} -T "$host" "$command" < /dev/null
fi
printf '%s\n' "Paste the credentials, then press Enter and Ctrl-D (input is hidden)." >&2
if [ -t 0 ]; then
    saved_tty=$(stty -g)
    trap 'stty "$saved_tty"' 0
    trap 'exit 130' HUP INT TERM
    stty -echo
fi
ssh ${PHUB_SSH_OPTS:-} -T "$host" "$command"
printf '%s\n' 'credentials installed' >&2
