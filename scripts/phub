#!/bin/sh
set -eu
# SSH accepts a command string, not a preserved argv. Quote every forwarded word.
quote() { printf "'"; printf '%s' "$1" | sed "s/'/'\\\\''/g"; printf "'"; }
host=${PHUB_SSH_HOST:-trading-macstudio}
remote_path=${PHUB_REMOTE_PATH:-/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin}
remote_docker=${PHUB_REMOTE_DOCKER:-docker}
prefix="export PATH=$(quote "$remote_path");"
if [ "${1:-}" = tunnel ]; then
    shift
    exec ssh ${PHUB_SSH_OPTS:-} -o ExitOnForwardFailure=yes -N -L 18080:127.0.0.1:18080 "$host" "$@"
fi
case ${1:-} in
    up|update)
        free=$(ssh ${PHUB_SSH_OPTS:-} "$host" "$prefix df -Pk ~" | awk 'END {print $4}')
        case $free in ''|*[!0-9]*) echo 'Cannot determine host free disk' >&2; exit 4;; esac
        if [ "$free" -lt 15728640 ]; then
            echo 'Host free disk space below 15 GiB' >&2; exit 4
        fi
        ;;
esac
command="$prefix $(quote "$remote_docker") --context colima-preview-hub exec -i phub-hub phub"
for arg do command="$command $(quote "$arg")"; done
exec ssh ${PHUB_SSH_OPTS:-} "$host" "$command"
