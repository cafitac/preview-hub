#!/usr/bin/env python3
"""Remote preview-hub CLI using the user's Cloudflare Access session."""

import argparse
import json
import os
import subprocess
import sys
import time
from urllib.parse import quote, urlsplit


def parser():
    result = argparse.ArgumentParser(description=__doc__)
    commands = result.add_subparsers(dest="command", required=True)
    for command in (
        "up",
        "update",
        "down",
        "status",
        "inventory",
        "wait-ready",
        "list",
    ):
        sub = commands.add_parser(command)
        if command != "list":
            sub.add_argument("name")
        if command in ("up", "update"):
            sub.add_argument("--set", action="append", required=True, dest="refs")
        if command == "up":
            sub.add_argument("--ttl")
        if command == "status":
            sub.add_argument("--descriptor", action="store_true")
        if command == "inventory":
            sub.add_argument("--expect-empty", action="store_true")
        if command == "wait-ready":
            sub.add_argument("--timeout", type=float, default=900)
            sub.add_argument("--interval", type=float, default=5)
    return result


def request(path, method, body, run):
    base = os.environ.get("PHUB_URL", "https://preview-hub.cafitac.com").rstrip("/")
    url = urlsplit(base)
    argv = [
        os.environ.get("PHUB_CLOUDFLARED", "cloudflared"),
        "access",
        "curl",
        base + path,
        "-sS",
        "--fail-with-body",
        "-w",
        "\n%{http_code}",
    ]
    if method != "GET":
        argv += [
            "-X",
            method,
            "-H",
            f"Origin: {url.scheme}://{url.netloc}",
            "-H",
            "Content-Type: application/json",
            "--data-binary",
            "@-",
        ]
    try:
        response = run(
            argv,
            input=json.dumps(body) if body is not None else "",
            capture_output=True,
            text=True,
            timeout=60,
        )
    except FileNotFoundError:
        print(f"Cloudflared binary not found: {argv[0]}", file=sys.stderr)
        return 2, None
    except (OSError, subprocess.TimeoutExpired) as exc:
        print(f"Cloudflared request failed: {exc}", file=sys.stderr)
        return 5, None
    try:
        content, status = response.stdout.rsplit("\n", 1)
        status = int(status.strip())
    except (ValueError, TypeError):
        print("Invalid response from Cloudflared", file=sys.stderr)
        return 5, None
    try:
        document = json.loads(content)
    except ValueError:
        document = {"error": f"HTTP {status}"}
        if 200 <= status < 300:
            print("Invalid JSON response from Cloudflared", file=sys.stderr)
            return 5, None
    if not 200 <= status < 300:
        error = (
            document.get("error", f"HTTP {status}")
            if isinstance(document, dict)
            else f"HTTP {status}"
        )
        print(error, file=sys.stderr)
        return {400: 2, 409: 3, 429: 4, 500: 5}.get(status, 5), document
    if not isinstance(document, (dict, list)):
        print("Invalid JSON response from Cloudflared", file=sys.stderr)
        return 5, None
    if response.returncode:
        print("Cloudflared request failed", file=sys.stderr)
        return 5, document
    return 0, document


def main(argv, run=subprocess.run, sleep=time.sleep, clock=time.monotonic):
    argparser = parser()
    args = argparser.parse_args(argv)
    path = "/api/environments"
    if args.command not in ("up", "list"):
        path += "/" + quote(args.name, safe="")
    method, body = "GET", None
    if args.command in ("up", "update"):
        services = {}
        for ref in args.refs:
            service, separator, value = ref.partition("=")
            if not separator or not service or not value:
                argparser.error("--set requires svc=ref")
            services[service] = value
        method, body = "POST", {"services": services}
        if args.command == "up":
            body["name"] = args.name
            if args.ttl:
                body["ttl"] = args.ttl
        else:
            path += "/update"
    elif args.command == "down":
        method, body = "DELETE", {}
    elif args.command == "inventory":
        path += "/inventory"
    elif args.command == "wait-ready" or (args.command == "status" and args.descriptor):
        path += "?format=descriptor"
    if args.command == "wait-ready":
        if args.timeout < 0 or args.interval <= 0:
            argparser.error("timeout must be nonnegative and interval must be positive")
        deadline, previous = clock() + args.timeout, None
        while True:
            code, document = request(path, method, body, run)
            if document is not None:
                state = document.get("state")
                healthy = document.get("readiness", {}).get("allHealthy") is True
                current = (state, healthy)
                if current != previous:
                    print(f"{state} allHealthy={healthy}", file=sys.stderr)
                    previous = current
            if code or state in ("FAILED", "DELETED") or (state == "READY" and healthy):
                break
            remaining = deadline - clock()
            if remaining <= 0:
                code = 6
                break
            sleep(min(args.interval, remaining))
        if not code and state in ("FAILED", "DELETED"):
            code = 5
    else:
        code, document = request(path, method, body, run)
        if (
            not code
            and args.command == "inventory"
            and args.expect_empty
            and not document.get("empty")
        ):
            code = 1
    if document is not None:
        print(json.dumps(document, indent=2))
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
