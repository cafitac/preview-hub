#!/bin/sh
set -eu
# Disable tracing even if invoked with sh -x. The token is only ever stdin data.
set +x
quote() { printf "'"; printf '%s' "$1" | sed "s/'/'\\\\''/g"; printf "'"; }
host=${PHUB_SSH_HOST:-trading-macstudio}
remote_path=${PHUB_REMOTE_PATH:-/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin}
case ${1:-} in
    --check) [ "$#" -eq 1 ] || exit 2; mode=check ;;
    '') [ "$#" -eq 0 ] || exit 2; mode=install ;;
    *) echo 'Usage: bot-token [--check] (token on stdin)' >&2; exit 2 ;;
esac
vm_script=$(cat <<'VM'
set -eu
set +x
file=/opt/phub/secrets/github_token
if [ "$1" = check ]; then
    if [ -f "$file" ] && [ -s "$file" ]; then
        echo 'token present'
        exit 0
    fi
    echo 'token missing'
    exit 1
fi
umask 077
mkdir -p /opt/phub/secrets
chmod 0700 /opt/phub/secrets
tmp=$(mktemp /opt/phub/secrets/.github_token.XXXXXX)
trap 'rm -f "$tmp"' 0 HUP INT TERM
cat > "$tmp"
[ -s "$tmp" ] || { echo 'token missing' >&2; exit 2; }
chown 0:0 "$tmp"
chmod 0400 "$tmp"
mv -f "$tmp" "$file"
VM
)
command="export PATH=$(quote "$remote_path"); colima ssh --profile preview-hub -- sudo -n sh -c $(quote "$vm_script") sh $(quote "$mode")"
if [ "$mode" = check ]; then
    exec ssh ${PHUB_SSH_OPTS:-} -T "$host" "$command" < /dev/null
fi
if [ -t 0 ]; then
    saved_tty=$(stty -g)
    trap 'stty "$saved_tty"' 0
    trap 'exit 130' HUP INT TERM
    stty -echo
fi
ssh ${PHUB_SSH_OPTS:-} -T "$host" "$command"
